# Fixing commit: 5549050bcbfabb2aa0d4628904639502d33d8658
diff --git a/Sources/Policy/Workspaces.swift b/Sources/Policy/Workspaces.swift
--- a/Sources/Policy/Workspaces.swift
+++ b/Sources/Policy/Workspaces.swift
@@ -99,9 +99,7 @@
                 if let focused { rails.select(focused) }
             }
             installKeys()
-            // A layout change retains the native selection. Its notification
-            // can still be queued behind an app's current AX read.
-            render(focusing: focused, relayout: true, takeFocus: false)
+            render(focusing: focused, relayout: true)
         }
         if !status.enabled {
             do { try closet.start() }
