#!/usr/bin/env python3
"""Check denial and automatic restart using a disposable runner's TCC database."""
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time

if os.environ.get("CI") != "true" or os.environ.get("GITHUB_ACTIONS") != "true":
    sys.exit("This permission test changes only a disposable GitHub runner. Grant Accessibility through System Settings locally.")
root = Path(__file__).resolve().parent.parent
app = root / ".build/apps/Tessel Dev.app"
cli = app / "Contents/MacOS/tessel"
pids = set()

with tempfile.TemporaryDirectory(prefix="tessel-permission-") as home:
    env = {**os.environ, "XDG_CONFIG_HOME": home}

    def status():
        result = subprocess.run([str(cli), "status", "--json"], env=env, capture_output=True, text=True, timeout=1.2)
        if result.returncode:
            return None
        value = json.loads(result.stdout)
        pids.add(value["pid"])
        return value

    def wait_for(predicate, seconds):
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            value = status()
            if value and predicate(value):
                return value
            time.sleep(0.025)
        raise AssertionError("permission state did not converge within the deadline")

    try:
        subprocess.run([str(root / "scripts/ci-accessibility"), "--deny-development"], check=True)
        subprocess.run(["open", "-n", "-g", "--stdout", "/dev/null", "--stderr", "/dev/null", "--env", "XDG_CONFIG_HOME=" + home, str(app)], check=True)
        initial = wait_for(lambda value: value["permission"] == "needed", 5)
        result = subprocess.run([str(cli), "windows", "--json"], env=env, capture_output=True, text=True, timeout=1)
        assert result.returncode != 0 and "Accessibility permission needed" in result.stderr
        print("E13: missing permission is reported by status and windows; visual evidence is separate.", flush=True)
        started = time.monotonic()
        subprocess.run([str(root / "scripts/ci-accessibility")], check=True)
        wait_for(lambda value: value["permission"] == "granted" and value["pid"] != initial["pid"], 3)
        elapsed = time.monotonic() - started
        assert elapsed < 3
        print(f"E14: automatic restart with permission granted in {elapsed:.3f} s; visual evidence is separate.", flush=True)
    finally:
        for pid in pids:
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        time.sleep(0.1)
