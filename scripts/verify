#!/bin/bash
# Drive the signed app through its CLI and isolated AppKit fixtures.
# With no suite or test name, runs the functional and resource suites.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
usage='Usage: scripts/verify [--functional] [--resources] [--permission] [TEST...]'
filters=()
for argument in "$@"; do
    case $argument in
        --functional) filters+=(--filter /Functional/ --filter /FunctionalWorkspaces/ --filter /FunctionalRails/) ;;
        --resources) filters+=(--filter /Resources/ --filter /Verification/) ;;
        --permission) filters+=(--filter /Permission/) ;;
        -h | --help) echo "$usage"; exit 0 ;;
        -*) echo "$usage" >&2; exit 2 ;;
        *) filters+=(--filter "$argument") ;;
    esac
done
if [[ ${#filters[@]} -eq 0 ]]; then
    filters=(--skip /Permission/)
fi
exec swift test --package-path "$root" --no-parallel "${filters[@]}"
